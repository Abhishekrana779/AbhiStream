{
  "name": "backend",
  "version": "1.0.0",
  "description": "AbhiStream Anime Streaming Backend",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:clean": "pkill -f 'src/server.ts' 2>/dev/null; sleep 1; NODE_OPTIONS=--max-old-space-size=4096 ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "multer": "^2.3.0",
    "nodemon": "^3.1.14",

    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {},
  "keywords": [],
  "license": "ISC"
}