PORT=5000
# Local MongoDB
# MONGO_URI=mongodb://127.0.0.1:27017/abhistream
# MongoDB Atlas (replace <password> and <dbname>)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.ht75yk1.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/abhistream
JWT_SECRET=abhi1234
# Default points at the public Vercel mirror, which serves metadata,
# search, genres, and /info successfully. Its /episodes and /watch
# streaming endpoints are Cloudflare-blocked for datacenter/shared IPs,
# so they return 403 on public hosting.
MIRURO_API_URL=https://mirurotvapi.vercel.app/api

# For playable video on the Watch page, self-host Miruro-API on a VPS
# or local machine (residential/non-datacenter IP) and point here.
# See https://github.com/walterwhite-69/Miruro-API
# MIRURO_API_URL=http://127.0.0.1:8000
CLIENT_URL=http://localhost:5173
